# EditorConfig configuration for Retrovibed
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tabs

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_style = spaces
indent_size = 2

[*.{yaml,yml}]
indent_style = spaces
indent_size = 2

[*.{go,sh}]
end_of_line = lf

[Makefile]
indent_style = tabs

