package main

import (
	"fmt"
	"log"
	"os"

	"github.com/alecthomas/kong"
	"github.com/james-lawrence/torrent/metainfo"
	"github.com/retrovibed/retrovibed/blockcache"
	"github.com/willabides/kongplete"
)

type Spike struct {
	ISO ISO `cmd:"" help:"convert a blockcache directory to ISO"`
}

type ISO struct {
	Dir    string `arg:"" help:"path to blockcache directory (will look for .torrent file)"`
	Output string `name:"output" short:"o" help:"output ISO file path"`
	Volume string `name:"volume" short:"v" default:"VOL" help:"ISO volume identifier"`
}

func main() {
	log.SetFlags(log.Lshortfile | log.LUTC | log.Ltime)

	var cli Spike

	parser := kong.Must(
		&cli,
		kong.Name("spike"),
		kong.Description("experimentation CLI"),
		kong.UsageOnError(),
	)

	kongplete.Complete(parser)

	pctx, err := parser.Parse(os.Args[1:])
	if err != nil {
		log.Fatalln(err)
	}

	if err = pctx.Run(); err != nil {
		log.Fatalln(err)
	}
}

func (c *ISO) Run() error {
	// Load the torrent metadata
	f, err := os.Open(c.Dir + ".torrent")
	if err != nil {
		return fmt.Errorf("failed to open torrent file: %w", err)
	}
	defer f.Close()

	meta, err := metainfo.Load(f)
	if err != nil {
		return fmt.Errorf("failed to parse torrent: %w", err)
	}

	info, err := meta.UnmarshalInfo()
	if err != nil {
		return fmt.Errorf("failed to decode torrent info: %w", err)
	}

	// Open the blockcache directory
	dcache, err := blockcache.NewDirectoryCache(c.Dir)
	if err != nil {
		return fmt.Errorf("failed to open blockcache: %w", err)
	}

	fs := blockcache.TorrentFilesystem(dcache, &info)

	// Write ISO
	if err := blockcache.WriteISO(fs, c.Output, c.Volume); err != nil {
		return fmt.Errorf("failed to write ISO: %w", err)
	}

	log.Printf("ISO created: %s", c.Output)
	return nil
}
