#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
DH_VERBOSE=1

%:
	CCACHE_DIR=${CCACHE_DIR} CCACHE_COMPILERCHECK=content CCACHE_DEBUG=1 CCACHE_DEBUGDIR=ccache-debug-1 dh $@

override_dh_auto_build:
	echo "DH AUTO BUILD OVERRIDE '${CMAKE_BUILD_PARALLEL_LEVEL}' pkg version '${PACKAGE_VERSION}'"

	# ccache -s

	# inet and vss are out-of-tree extensions fetched via network during cmake configure,
	# which Launchpad's sandboxed builders block. Leave them out and rely on
	# ENABLE_EXTENSION_AUTOLOADING/AUTOINSTALL to pull them in at runtime instead.
	#
	# LDFLAGS (cmake seeds CMAKE_*_LINKER_FLAGS from it) links libduckdb.so with a private, hidden copy of libstdc++ and
	# libgcc's unwinder (DT_NEEDED reduced to libc/libm). the flutter linux engine (libflutter_linux_gtk.so) exports llvm
	# libunwind's _Unwind_* symbols and is loaded ahead of libgcc_s, so a libduckdb.so linked against the system
	# libstdc++ resolves its unwinder to flutter's. exceptions duckdb throws internally then can't be caught and the
	# process aborts with: terminate called after throwing an instance of 'duckdb::Exception'
	# see CompileRuntime in .eg/debuild/duckdb/duckdb.build.go, which sets the same flags.
	LDFLAGS="-static-libstdc++ -static-libgcc -Wl,--exclude-libs,libstdc++.a:libgcc.a:libgcc_eh.a" GEN=ninja OVERRIDE_GIT_DESCRIBE="v${PACKAGE_VERSION}" GIT_COMMIT_HASH="${GIT_COMMIT_HASH}" ENABLE_EXTENSION_AUTOLOADING=1 ENABLE_EXTENSION_AUTOINSTALL=1 BUILD_EXTENSIONS='autocomplete;json;parquet;icu' DUCKDB_BUILD=Static make -C src
	DESTDIR="linux" cmake --install src/build/release --prefix="/usr"


override_dh_usrlocal:
	echo "DH usrlocal override due to over restrict rules"
