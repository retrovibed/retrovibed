#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
# DH_VERBOSE = 1

# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

%:
	dh $@

override_dh_auto_build:
	echo "DH AUTO BUILD OVERRIDE"
	echo "$(CURDIR)"
	mkdir -p $(CURDIR)/linux/usr/bin
	# need to set gocache otherwise it'll error out on launchpad builders
	cp -R $(CURDIR)/src/.dist/linux/* linux
	cp $(CURDIR)/src/LICENSE $(CURDIR)/debian/copyright

	# build neurals
	# dependencies are vendored (see src/neurals/vendor, generated via `cargo vendor`)
	# since launchpad builders have no network access; --config avoids relying on
	# .cargo/config.toml file-discovery, which starts from CURDIR, not the manifest's directory.
	CARGO_TARGET_DIR="native" cargo build --manifest-path src/neurals/Cargo.toml --release \
		--config 'source.crates-io.replace-with="vendored-sources"' \
		--config 'source.vendored-sources.directory="src/neurals/vendor"' \
		--offline
	tree -L 1 $(CURDIR)/native/release
	cp $(CURDIR)/native/release/libpredicttext.a native/release/libpredicttext.so $(CURDIR)/linux/usr/lib/retrovibed/

	CGO_LDFLAGS="-L$(CURDIR)/linux/usr/lib/retrovibed -Wl,-rpath,/usr/lib/retrovibed" GOPROXY="direct" GOCACHE="$(CURDIR)/.gocache" GOMODCACHE="$(CURDIR)/.gomod" GOBIN="$(CURDIR)/linux/usr/bin" /usr/lib/go-1.26/bin/go build -C src/shallows -mod=vendor -buildmode=pie -tags "duckdb_use_lib,retrovibed,neural" -buildvcs=false -o "$(CURDIR)/linux/usr/bin" ./cmd/retrovibe/...
	tree $(CURDIR)/linux

override_dh_auto_test:
	echo "DH AUTO TEST OVERRIDE"
	# version command causes a directory to be created. need to prevent that.
	# CACHE_DIRECTORY="$(CURDIR)" $(CURDIR)/linux/usr/bin/retrovibed version


override_dh_dwz:
    # Do nothing - this effectively disables dwz. golang does its own thing.

override_dh_clean:
	# dh_clean's default sweep deletes *.orig anywhere in the tree (meant for
	# patch-reject droppings), which also deletes the Cargo.toml.orig files
	# cargo vendor ships inside src/neurals/vendor; exclude that path.
	dh_clean -Xsrc/neurals/vendor
