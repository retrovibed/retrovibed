FROM ubuntu:resolute
ARG DEBIAN_FRONTEND=noninteractive
ARG GOBIN="/usr/bin"
ARG GOMODCACHE="/tmp/gomod"
ARG GOCACHE="/tmp/gocache"

RUN echo "cache buster 059a9a06-1686-4f49-9a7f-a30535886d59"
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 update
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 install -y software-properties-common build-essential ca-certificates curl sudo
RUN add-apt-repository -n ppa:longsleep/golang-backports
RUN add-apt-repository -n ppa:egdaemon/eg
RUN add-apt-repository -n ppa:jljatone/retrovibed

RUN echo "cache buster 059a9a06-1686-4f49-9a7f-a30535886d55"
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 update && apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 -y install golang-1.27 egworkload duckdb podman netavark rsync vim dput devscripts dh-make dput uidmap dbus-user-session git unzip xz-utils zip libglu1-mesa clang lld cmake git ninja-build pkg-config libgtk-3-dev liblzma-dev libstdc++-12-dev
RUN sh /usr/share/eg/install/github.sh > /dev/null
RUN echo "cache buster 059a9a06-1686-4f49-9a7f-a30535886d50"
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 update && apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 -y install snapd protobuf-compiler pkgconf clang-19 gh tree flatpak-builder libmpv-dev libavcodec-dev libavformat-dev libavutil-dev libswresample-dev libavfilter-dev libavdevice-dev libswscale-dev xwayland-run

RUN ln -s /usr/lib/go-1.27/bin/go /usr/local/bin/go

# install genieql and golang's protocol buffers and other dev tooling.
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@latest
RUN go install github.com/fatih/gomodifytags@latest
RUN echo "cache buster e4c1f2a7-9b3d-4e6a-8f1c-2d7a5b9e0c31"
RUN GOPROXY=direct go install -tags duckdb_use_lib github.com/james-lawrence/genieql/...@latest
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest

# install flatpak
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 update && apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 -y install tree flatpak-builder libmpv-dev
RUN flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

# install flutter
RUN echo "cache buster 159a9a06-1686-4f49-9a7f-a30535786d59"
RUN git clone -b stable --depth 1 https://github.com/flutter/flutter.git /opt/flutter
RUN ln -s /opt/flutter/bin/flutter /usr/local/bin/flutter
RUN ln -s /opt/flutter/bin/dart /usr/local/bin/dart
RUN protoc --version
RUN chown -R egd:egd /opt/flutter
RUN sudo -H -S -u egd -g egd flutter precache --linux --android --ios
RUN sudo -H -S -u egd -g egd flutter config --no-analytics
RUN sudo -H -S -u egd -g egd flutter --disable-analytics
RUN sudo -H -S -u egd -g egd dart pub global activate protoc_plugin 25.1.0

RUN echo "cache buster 159a9a06-1686-4f49-9a7f-a30535786d59"
# install appimage-builder for AppImage packaging
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 update && apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 -y install pipx python3-dev python3-venv python3-apt squashfs-tools patchelf desktop-file-utils libgdk-pixbuf-xlib-2.0-dev fakeroot gnupg2 zsync
# Use pipx to install appimage-builder globally (available in /usr/local/bin)
RUN PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install git+https://github.com/AppImageCrafters/appimage-builder.git@james.lawrence/cachedir

RUN curl -sSfL https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$(uname -m).AppImage -o /usr/local/bin/appimagetool \
    && chmod +x /usr/local/bin/appimagetool

# noop apt-key (deprecated in newer Ubuntu, causes errors in some tools, specifically appimage-builder which doesnt use it but checks for it)
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/apt-key && chmod +x /usr/local/bin/apt-key

RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 install -y rustup
RUN sudo -u egd rustup default stable
ENV PATH=/home/egd/.cargo/bin:$PATH

RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 update && apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 install -y cargo rustc wayland-utils waypipe

# pre-install duckdb extensions used by shallows migrations so codegen doesn't need network access at runtime.
# and because genieql needs them to execute the migrations....
RUN sudo -H -S -u egd -g egd duckdb -c "INSTALL icu; INSTALL inet; INSTALL vss;"

RUN systemd-tmpfiles --create
RUN systemd-tmpfiles --clean
RUN rm -rf /tmp/gomod /tmp/gocache
RUN du -xsh /tmp/*

RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 -y install openssh-server npm
RUN npm install -g @anthropic-ai/claude-code

# file watcher used by the dev console services (.eg/dev/.systemd) to hot reload.
RUN echo "cache buster 2f6b1c0e-5d3a-4b7e-9a41-8c2d7e0f6a15"
RUN curl -fsSL -o /tmp/watchexec.deb https://github.com/watchexec/watchexec/releases/download/v2.8.0/watchexec-2.8.0-$(uname -m)-unknown-linux-gnu.deb && apt-get install -y /tmp/watchexec.deb && rm /tmp/watchexec.deb
